# =====================================================================
# LongCat-Video-API 服务环境变量示例（生产推荐值）
# ---------------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   按需修改下面带 <> 的路径与端口
#   ./start.sh          # start.sh 会自动 source .env 并注入 PYTHONPATH
#
# 说明：
#   - config.py 也会尝试用 python-dotenv 自动加载 .env；若未装 python-dotenv，
#     请用 start.sh 或在 shell / systemd 里自行 export。
#   - 显式设置 LONGCAT_CHECKPOINT_DIR_VIDEO 可避免 ../LongCat-Video 兄弟目录
#     回退失效（这是早期 OSError: Incorrect path_or_model_id 的根因）。
#   - 端口按你容器实际开放端口改（本例 8080）。
# =====================================================================

# ---------- 服务监听 ----------
LONGCAT_HOST=0.0.0.0
# 容器开放端口（你的环境是 8080，非默认 8000），按反代实际改
LONGCAT_PORT=8080

# ---------- 模型权重目录（必须显式指定！避免 ../LongCat-Video 兄弟目录回退失效） ----------
# 基础视频模型：tokenizer / text_encoder / vae / scheduler 来自这里
LONGCAT_CHECKPOINT_DIR_VIDEO=/opt/ml/cctv/LongCat-Video
# 数字人权重
LONGCAT_CHECKPOINT_DIR_AVATAR=/opt/ml/cctv/LongCat-Video-API/weights/LongCat-Video-Avatar-1.5

# ---------- 一体化常驻 Worker（默认开启，免去每次请求重加载 ~40GB 权重） ----------
LONGCAT_INPROCESS=1
LONGCAT_WORKER_HOST=127.0.0.1
LONGCAT_WORKER_PORT=29500

# ---------- 模型与精度 ----------
LONGCAT_MODEL_TYPE=avatar-v1.5
# single = 走进程内常驻 Worker；multi = 仍走子进程（v1 仅 single 支持进程内）
LONGCAT_AVATAR_MODE=single
# INT8 量化：省显存、并降低加载期 CPU 内存峰值（配合 accelerate 解决 OOM/SIGKILL）
LONGCAT_USE_INT8=1

# ---------- 分布式 / 多卡 ----------
# 每任务使用的 GPU 数（torchrun nproc_per_node）
LONGCAT_NUM_GPUS=2
# 上下文并行尺寸，默认等于 NUM_GPUS；显存吃紧可加大（把激活摊薄到多卡）
LONGCAT_CONTEXT_PARALLEL_SIZE=2
LONGCAT_GPU_CONCURRENCY=1
LONGCAT_ENABLE_COMPILE=0

# ---------- 工作目录（上传 / 输出 / 日志 / 任务库） ----------
LONGCAT_WORK_DIR=/opt/ml/cctv/LongCat-Video-API/api_work
LONGCAT_UPLOAD_TTL_SECONDS=86400

# ---------- H5 嵌入 + 登录网关（生产建议开启，按需取消注释） ----------
# LONGCAT_EMBED_H5=1
# LONGCAT_AUTH=1
# LONGCAT_USER=admin
# LONGCAT_PASS=改成强密码
# LONGCAT_AUTH_TOKEN=改成随机串
