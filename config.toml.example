# =============================================================================
# LongCat-Video-API 全局配置文件 (config.toml)
# -----------------------------------------------------------------------------
# 本文件为【低配安全启动档】默认模板：面向 单卡 A100-40G（约 40GB 显存）部署，
# 开箱即跑、不会被 OOM killer 杀掉（SIGKILL），也不会显存溢出（CUDA OOM）。
#
# 使用方法：
#   cp config.toml.example config.toml
#   vim config.toml          # 按需修改（建议至少设置 [server].auth_pass）
#   LONGCAT_CONFIG=config.toml 或保持默认（默认读 <仓库根>/config.toml）
#
# 取值优先级（高 -> 低）：
#   1. 环境变量 LONGCAT_*        （容器 / systemd 部署最方便，优先权最高）
#   2. 本文件 config.toml
#   3. config.py 中的内置默认
#
# 注意：本文件的值会在服务启动时回灌进环境变量，使每次请求拉起的 torchrun
#       子进程也能继承同一份配置（真正的“全局统一管理”）。
#
# ── 高配放松（若你有多卡 / 大显存，可把下面这些放开）─────────────────────
#   [profile] a100_40g_enabled = false
#             → 关闭 40G 封顶，恢复客户端对分辨率/步数/guidance 的完全控制
#             （段数本就 auto 自适应、与显存无关，无需因高配才放开）
#   [runtime] num_gpus = N, context_parallel_size = N
#             → 多卡把模型与激活摊开，可上 720p / 50 步
# =============================================================================

# -----------------------------------------------------------------------------
# 服务端口与鉴权（常驻进程，改这里后必须重启 API 服务）
# -----------------------------------------------------------------------------
[server]
host = "0.0.0.0"
port = 8000

# 鉴权门禁：低配安全档默认“关闭”以便直接启动；但生产环境强烈建议开启。
#   * 开启后【必须】设置 auth_pass（见下方 fail-closed 说明），否则服务启动即失败。
#   * 本模板默认 auth_enabled=false，避免“复制即启动失败”；上线请改为 true。
auth_enabled = false
auth_user = "admin"
# 密码：留空字符串 "" 表示“未设置”。一旦 auth_enabled=true 且密码为空，
# 服务启动直接失败退出（fail-closed），强制你配置强密码。
# 生产建议：auth_enabled=true 时在此填一个强密码，例如 "Lc@2026!vApi#9q"。
auth_pass = ""
# cookie secret：留空则启动时自动生成随机值并打印（每次重启都会变）。
# 想固定 secret（如多实例共享登录态）就在这里或 LONGCAT_AUTH_TOKEN 设置。
auth_token = ""

# 启用 FastAPI 内嵌 H5：访问 `/` 时由 FastAPI 返回 h5/index.html，
# 并动态注入 `/h5/progress.js`，用于显示后端真实任务阶段进度。
# 环境变量 LONGCAT_EMBED_H5 优先级更高：1=启用，0=关闭。
embed_h5 = true

# -----------------------------------------------------------------------------
# 模型权重目录（留空 = 使用默认 <仓库根>/weights/... 布局）
# 你的服务器实际路径通过环境变量 LONGCAT_CHECKPOINT_DIR_VIDEO 指定，这里留空即可。
# -----------------------------------------------------------------------------
[model]
checkpoint_dir_video = ""
checkpoint_dir_avatar_v1 = ""
checkpoint_dir_avatar_v15 = ""

# -----------------------------------------------------------------------------
# 分布式 / 运行时（低配安全档：单卡、不编译、串行）
# -----------------------------------------------------------------------------
[runtime]
num_gpus = 1
# 上下文并行度：0 表示 = num_gpus（即本档单卡为 1）。多卡时设 = num_gpus 可摊激活。
context_parallel_size = 0
# torch.compile：低配档建议关闭，编译期额外占显存且偶有不稳定；大显存机器可开。
enable_compile = false
# 同时占用 GPU 的任务数：40G 单卡只跑 1 个，并发会显存溢出，保持 1。
gpu_concurrency = 1
# 工作目录（上传/输出/日志）：留空用默认 <仓库根>/api_work
work_dir = ""
# 上传文件存活秒数（0=不清理）；默认 1 天，避免磁盘被临时文件堆满。
upload_ttl_seconds = 86400

# -----------------------------------------------------------------------------
# 单卡 A100-40G 安全档（低配核心）
#   * 对 avatar-v1.5 请求做“上限封顶”（只降不升）：仅分辨率超过上限会被压回。
#   * 段数(num_segments)默认 "auto"：按音频时长自适应（滑动窗口串行，每段独立前向、
#     用完即释放显存/内存，不额外占显存，故无需为防 OOM 压成 1 段，可处理任意时长音频）。
#     仅当 max_num_segments>0 时才对自动算出的段数做封顶。
#   * 对显存有风险的项【强制】INT8 量化 + 8 步蒸馏，从根上防 OOM。
#   * 客户端显式传的 text/audio guidance 一律保留，不再静默覆盖。
#   * 触发封顶时会在日志打印 warning，方便你感知被降级。
# -----------------------------------------------------------------------------
[profile]
a100_40g_enabled = true
max_resolution = "480p"          # 单卡 40G 安全上限；多卡可放宽到 720p
max_num_segments = 0             # 0=不限制（默认 auto 按音频时长自适应段数）；生产担心超长音频耗时爆炸可设上限如 30
forced_num_inference_steps = 8   # 强制 8 步蒸馏采样（快且省显存）
force_use_int8 = true            # 强制 INT8 量化 DiT（显存 ~降一半）
force_use_distill = true         # 强制蒸馏 LoRA（8 步而非 50 步）
# 以下两项仅作为 schema 默认值来源（客户端显式传值时不覆盖）：
text_guidance_scale = 1.0
audio_guidance_scale = 1.0
